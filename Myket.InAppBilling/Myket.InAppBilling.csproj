<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-android</TargetFramework>
        <UseMaui>true</UseMaui> <!-- این خط بسیار مهم است -->
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
        <PackageId>Myket.InAppBilling</PackageId>
        <Version>0.0.4</Version>
        <Authors>Milad Xandi</Authors>
        <Description>Myket In-App Billing Library for .NET MAUI</Description>
        <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/miladxandi/Myket.InAppBilling</RepositoryUrl>
        <PackageTags>maui;myket;myket iab;myket iap;myket android;iran;persian</PackageTags>
        <NeutralLanguage>fa-IR</NeutralLanguage>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>Android 34 and 35 payment problems has been fixed</PackageReleaseNotes>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/miladxandi/Myket.InAppBilling</PackageProjectUrl>
        <Copyright>Milad Xandi</Copyright>
        <Title>Myket In-App Bulling</Title>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <UserSecretsId>e1ae12dc-9fb3-41e6-b2eb-3b9666b26508</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\icon.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
      <None Include="..\LICENSE">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
      <None Include="..\ReadMe.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.100" />
      <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    </ItemGroup>

</Project>